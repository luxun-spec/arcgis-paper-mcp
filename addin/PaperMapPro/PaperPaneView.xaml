<UserControl x:Class="PaperMapPro.PaperPaneView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:framework="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
 MinWidth="320" FontFamily="Microsoft YaHei UI" FontSize="12" Background="#F1F7FC">
 <UserControl.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="0,3,6,3"/><Setter Property="Padding" Value="10,5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,3"/><Setter Property="framework:AttachedProperties.BlockShortcuts" Value="True"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="12">
  <TextBlock Text="论文制图助手" FontSize="19" FontWeight="SemiBold" Foreground="#176BA5"/>
  <TextBlock Text="输入需求 → 获取数据 → Pro 制图" Foreground="#5E778A" Margin="0,6,0,12"/>
  <Border Background="#E2EFF9" CornerRadius="5" Padding="10">
   <StackPanel><TextBlock x:Name="Status" Text="等待输入需求" TextWrapping="Wrap"/>
    <ProgressBar x:Name="Progress" Height="4" Margin="0,9,0,0" Minimum="0" Maximum="100"/>
    <TextBlock x:Name="Elapsed" Foreground="#64839B" Margin="0,5,0,0" FontSize="10"/>
   </StackPanel>
  </Border>
  <Expander Header="运行记录" IsExpanded="False" Margin="0,7">
   <TextBox x:Name="RunLog" IsReadOnly="True" Height="125" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="10" Background="#E5F0F9"/>
  </Expander>
  <RichTextBox x:Name="Conversation" IsReadOnly="True" Height="175" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F1F7FC" framework:AttachedProperties.BlockShortcuts="True"/>
  <TextBlock Text="你的制图需求" FontWeight="SemiBold" Margin="0,8,0,2"/>
  <TextBox x:Name="Demand" AutomationProperties.AutomationId="PaperMapDemand" AcceptsReturn="True" Height="88" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="例如：帮我画一个云南省的研究区图，只用DEM"/>
  <WrapPanel>
   <Button x:Name="Send" Content="发送需求" Click="Send_Click" Background="#176BA5" Foreground="White" AutomationProperties.AutomationId="PaperMapSend"/>
   <Button x:Name="Stop" Content="停止后续步骤" Click="Stop_Click" IsEnabled="False"/>
   <Button Content="清空对话" Click="Clear_Click"/>
  </WrapPanel>
  <TextBlock Text="未配模型时使用有限地名规则；复杂需求请设置模型。" TextWrapping="Wrap" Foreground="#627B90" FontSize="10" Margin="0,2,0,8"/>
  <Border x:Name="CandidatePanel" Visibility="Collapsed" Background="White" Padding="8" Margin="0,5">
   <StackPanel><TextBlock Text="发现多个地区，请选择正确边界" TextWrapping="Wrap"/>
    <ListBox x:Name="Candidates" Height="90" DisplayMemberPath="Name"/>
    <Button Content="使用所选地区制图" Click="Choose_Click"/>
   </StackPanel>
  </Border>
  <Expander x:Name="Parameters" Header="制图参数与输出" IsExpanded="False" Margin="0,5">
   <StackPanel>
    <TextBlock Text="地区（规则未识别时手动指定，可留空）"/>
    <TextBox x:Name="Region" AutomationProperties.AutomationId="PaperMapRegion"/>
    <TextBlock Text="地形风格" Margin="0,4,0,0"/>
    <ComboBox x:Name="Palette" SelectedIndex="0"><ComboBoxItem Tag="natural" Content="自然绿灰"/><ComboBoxItem Tag="earth" Content="大地暖色"/><ComboBoxItem Tag="gray" Content="灰度地形"/></ComboBox>
    <TextBlock Text="地形瓦片级别（5–12，初次建议7）"/>
    <TextBox x:Name="Zoom" Text="7"/>
    <TextBlock Text="晕渲强度（0–1）"/>
    <TextBox x:Name="Relief" Text="0.35"/>
    <TextBlock Text="经纬网"/>
    <ComboBox x:Name="GridMode" SelectedIndex="0"><ComboBoxItem Tag="labels" Content="只显示坐标"/><ComboBoxItem Tag="full" Content="显示网格线"/><ComboBoxItem Tag="off" Content="关闭经纬网"/></ComboBox>
    <TextBlock Text="输出父目录"/>
    <TextBox x:Name="OutputFolder"/>
    <Button Content="选择输出目录" Click="Folder_Click" HorizontalAlignment="Left"/>
    <TextBlock Text="使用当前已保存工程作为种子，新建输出目录；完成后将布局导入当前工程，不覆盖已有布局。" TextWrapping="Wrap" FontSize="10" Foreground="#627B90"/>
   </StackPanel>
  </Expander>
  <Expander x:Name="Connection" Header="模型与连接设置" IsExpanded="False" Margin="0,5">
   <StackPanel>
    <TextBlock Text="模型接口地址（通常以 /v1 结尾）"/>
    <TextBox x:Name="Endpoint"/>
    <TextBlock Text="模型名称"/>
    <TextBox x:Name="Model"/>
    <TextBlock Text="API Key（只保留本次 Pro 会话）"/>
    <PasswordBox x:Name="ApiKey" Padding="6" Margin="0,5" framework:AttachedProperties.BlockShortcuts="True"/>
    <TextBlock Text="配置模型后，发送需求会将文本传给该服务。Key 不写入文件、日志或项目；不需要把 Key 交给别人。兼容 Chat Completions JSON 模式。" TextWrapping="Wrap" FontSize="10" Foreground="#627B90"/>
    <TextBlock Text="ArcGIS Pro Python" Margin="0,7,0,0"/>
    <TextBox x:Name="PythonPath"/>
    <WrapPanel><Button Content="检查连接" Click="Ping_Click"/><Button Content="保存设置（不含Key）" Click="Save_Click"/></WrapPanel>
   </StackPanel>
  </Expander>
  <Expander Header="数据范围与限制" Margin="0,5"><TextBlock Text="当前窗口：公开地区边界、高程地形、区域定位图。高程是混合来源瓦片，不能保证指定年份或30米分辨率。暂不自动获取土地利用、气象、影像、河流和采样点；遇到这些需求会提示并停止。社区边界不代替法定测绘边界。" TextWrapping="Wrap" Foreground="#627B90" FontSize="10"/></Expander>
  <Border x:Name="ResultPanel" Visibility="Collapsed" Background="White" Padding="8" Margin="0,8">
   <StackPanel><TextBlock Text="制图成果" FontWeight="SemiBold"/>
    <Image x:Name="Preview" MaxHeight="170" Stretch="Uniform" Margin="0,8"/>
    <WrapPanel><Button Content="显示布局" Click="ShowLayout_Click"/><Button Content="打开图片" Click="Image_Click"/><Button Content="成果文件夹" Click="Results_Click"/></WrapPanel>
   </StackPanel>
  </Border>
 </StackPanel>
 </ScrollViewer>
</UserControl>
